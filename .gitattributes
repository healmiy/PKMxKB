# --- Text files: normalize to LF ---
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.html  text eol=lf

# Scripts
*.sh   text eol=lf
*.py   text eol=lf

# --- Git LFS: binary/large files ---
# Images
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.gif   filter=lfs diff=lfs merge=lfs -text
*.webp  filter=lfs diff=lfs merge=lfs -text
*.svg   filter=lfs diff=lfs merge=lfs -text

# Documents
*.pdf   filter=lfs diff=lfs merge=lfs -text
*.pptx  filter=lfs diff=lfs merge=lfs -text
*.docx  filter=lfs diff=lfs merge=lfs -text
*.xlsx  filter=lfs diff=lfs merge=lfs -text

# Media
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.m4a  filter=lfs diff=lfs merge=lfs -text

# Fonts
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.woff  filter=lfs diff=lfs merge=lfs -text

# Obsidian plugin JS bundles (third-party, large, rarely diffed)
.obsidian/plugins/**/*.js  filter=lfs diff=lfs merge=lfs -text
.obsidian/plugins/**/*.css filter=lfs diff=lfs merge=lfs -text
